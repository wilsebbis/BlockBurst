{
  "name": "block-burst",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Block Burst: a cozy Block Blast-style 8x8 block puzzle for the web. Adventure levels in order, a Sanctuary for the blobs you clear, and a Penguin Exhibit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "verify-boards": "tsx scripts/verify-boards.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
